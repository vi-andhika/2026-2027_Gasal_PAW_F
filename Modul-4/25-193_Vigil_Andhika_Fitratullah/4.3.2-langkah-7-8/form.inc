<?php
$surname    = isset($_POST['surname']) ? htmlspecialchars($_POST['surname']) : '';
$email      = isset($_POST['email'])   ? htmlspecialchars($_POST['email'])   : '';
$address    = isset($_POST['address']) ? htmlspecialchars($_POST['address']) : '';
$state      = isset($_POST['state'])   ? $_POST['state'] : '-1';
$sex        = isset($_POST['sex'])     ? $_POST['sex']   : '';
$vegetarian = isset($_POST['vegetarian']);

$states = array(
    '1' => 'Australian Capital Territory',
    '2' => 'Queensland',
    '3' => 'Victoria',
    '4' => 'New South Wales',
    '5' => 'Tasmania',
    '6' => 'South Australia',
    '7' => 'Western Australia',
    '8' => 'Northern Territory'
);
?>
<fieldset>
  <legend>Person Details</legend>
  <form name="myForm" action="processData_form.php" method="POST">
    <div class="field">
      <label for="surname">Surname</label>
      <input type="text" name="surname" id="surname" size="31" value="<?php echo $surname; ?>"/>
    </div>
    <div class="field">
      <label for="email">Email address</label>
      <input type="text" name="email" id="email" size="31" value="<?php echo $email; ?>"/>
    </div>
    <div class="field">
      <label for="passwd">Password</label>
      <input type="password" name="passwd" id="passwd" size="31"/>
    </div>
    <div class="field">
      <label for="address">Street Address</label>
      <textarea name="address" id="address" rows="3" cols="22"><?php echo $address; ?></textarea>
    </div>
    <div class="field">
      <label for="state">State</label>
      <select name="state" id="state">
        <option value="-1"<?php if ($state == '-1') echo ' selected'; ?>>[choose your state]</option>
        <?php
        foreach ($states as $value => $name)
        {
            $selected = ($state == (string)$value) ? ' selected' : '';
            echo "<option value=\"$value\"$selected>$name</option>\n        ";
        }
        ?>
      </select>
    </div>
    <div class="field">
      <input type="hidden" name="country" value="Australia"/>
    </div>
    <div class="field">
      <label>Gender</label>
      <span>
        <input type="radio" name="sex" id="male" value="male"<?php if ($sex == 'male') echo ' checked'; ?>/>
        <label class="inline" for="male">Male</label>
        <input type="radio" name="sex" id="female" value="female"<?php if ($sex == 'female') echo ' checked'; ?>/>
        <label class="inline" for="female">Female</label>
      </span>
    </div>
    <div class="field">
      <label for="vegetarian">Vegetarian?</label>
      <input type="checkbox" name="vegetarian" id="vegetarian"<?php if ($vegetarian) echo ' checked'; ?>/>
    </div>
    <div class="field">
      <label>&nbsp;</label>
      <span>
        <input type="submit" value="Submit" name="submit"/>
        <input type="reset" value="Reset" name="reset"/>
      </span>
    </div>
  </form>
</fieldset>
